  "@id": "urn:noocodex:dag:crawl:discover",
  "@type": "DAG",
  "name": "crawl:discover",
  "version": "1.0",
  "entrypoint": "crawl:init-frontier",
  "nodes": [
    {
      "@id": "urn:noocodex:dag:crawl:discover/node/crawl:init-frontier",
      "@type": "SingleNode",
      "name": "crawl:init-frontier",
      "node": "crawl:init-frontier",
      "outputs": {
        "ready": "crawl:fetch-and-extract",
        "empty": "crawl:completed"
      }
    },
    {
      "@id": "urn:noocodex:dag:crawl:discover/node/crawl:fetch-and-extract",
      "@type": "SingleNode",
      "name": "crawl:fetch-and-extract",
      "node": "crawl:fetch-and-extract",
      "outputs": {
        "success": "crawl:dedupe-and-enqueue",
        "empty": "crawl:dedupe-and-enqueue",
        "error": "crawl:dedupe-and-enqueue",
        "permanent": "crawl:dedupe-and-enqueue"
      }
    },
    {
      "@id": "urn:noocodex:dag:crawl:discover/node/crawl:dedupe-and-enqueue",
      "@type": "SingleNode",
      "name": "crawl:dedupe-and-enqueue",
      "node": "crawl:dedupe-and-enqueue",
      "outputs": {
        "frontier-ready": "crawl:fetch-and-extract",
        "frontier-empty": "crawl:exhausted",
        "budget-exhausted": "crawl:exhausted"
      }
    },
    {
      "@id": "urn:noocodex:dag:crawl:discover/node/crawl:exhausted",
      "@type": "SingleNode",
      "name": "crawl:exhausted",
      "node": "crawl:exhausted",
      "outputs": {
        "success": "crawl:completed"
      }
    },
    {
      "@id": "urn:noocodex:dag:crawl:discover/node/crawl:completed",
      "@type": "TerminalNode",
      "name": "crawl:completed",
      "outcome": "completed"
    }
  ]
}