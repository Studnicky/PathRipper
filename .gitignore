# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# next.js build output
.next

# output and reports
reports
data

# Build / scrape output
dist/
output/
# Example output files are committed as documentation of expected output shape
!examples/**/output/
!examples/**/output/**

# Compiled plugin outputs (built from plugins/**/*.ts via tsconfig.plugins.json)
plugins/**/*.js
plugins/**/*.js.map
plugins/**/*.d.ts

# Compiled artifacts must never land in src/ (only in dist/)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts

# User's local configs — never committed.
# Only the canonical `ripperoni.config.example.json` is tracked.
ripperoni.config*.json
!ripperoni.config.example.json

# Harness / tooling state
.claude/
.enginseer/

# OS
.DS_Store
.orchestration/
.env

# Target-specific plugin source is now tracked under plugins/
# Compiled outputs (*.js, *.d.ts, *.js.map) stay ignored (see rules above).
docs/.vitepress/dist/

# Plans are local-only working documents; not published
docs/plans/
