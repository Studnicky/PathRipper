  "@id": "urn:noocodex:dag:aonprd:scrape",
  "@type": "DAG",
  "name": "aonprd:scrape",
  "version": "1.0",
  "entrypoint": "scatter-pages",
  "nodes": [
    {
      "@id": "urn:noocodex:dag:aonprd:scrape/node/scatter-pages",
      "@type": "ScatterNode",
      "name": "scatter-pages",
      "source": "urls",
      "body": {
        "dag": "aonprd:page"
      },
      "gather": {
        "strategy": "discard"
      },
      "outputs": {
        "all-success": "aonprd-scrape:completed",
        "partial": "aonprd-scrape:completed",
        "all-error": "aonprd-scrape:failed",
        "empty": "aonprd-scrape:completed"
      },
      "itemKey": "currentItem",
      "reducer": "aggregate"
    },
    {
      "@id": "urn:noocodex:dag:aonprd:scrape/node/aonprd-scrape:completed",
      "@type": "TerminalNode",
      "name": "aonprd-scrape:completed",
      "outcome": "completed"
    },
    {
      "@id": "urn:noocodex:dag:aonprd:scrape/node/aonprd-scrape:failed",
      "@type": "TerminalNode",
      "name": "aonprd-scrape:failed",
      "outcome": "failed"
    }
  ]
}