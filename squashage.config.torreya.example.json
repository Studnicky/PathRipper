{
  "input": {
    "basePath": "./output/torreya",
    "format": "json"
  },
  "targets": {
    "bulbapedia": {
      "input": "./output/torreya/bulbapedia",
      "pipeline": [
        "json:read",
        "bulbapedia:classify",
        "bulbapedia:squash-pokemon",
        "bulbapedia:squash-move",
        "bulbapedia:squash-tcg",
        "bulbapedia:squash-location",
        "rdfjs:finalize"
      ],
      "graphs": {
        "pokemon": "https://pokemontology.dev/graph/universal/species",
        "moves": "https://pokemontology.dev/graph/universal/moves",
        "tcg": "https://pokemontology.dev/graph/tcg/cards",
        "locations": "https://pokemontology.dev/graph/universal/locations",
        "ribbons": "https://pokemontology.dev/graph/universal/ribbons",
        "marks": "https://pokemontology.dev/graph/universal/marks"
      },
      "classification": {
        "onConflict": "quarantine",
        "onUnknown": "quarantine",
        "evidence": true
      },
      "ontology": {
        "baseIri": "https://pokemontology.dev/",
        "prefixes": {
          "pkm": "https://pokemontology.dev/ontology#",
          "pkcard": "https://pokemontology.dev/tcg/ontology#",
          "pkgo": "https://pokemontology.dev/go/ontology#"
        }
      },
      "quarantine": {
        "dir": "./graphs/torreya/quarantine/bulbapedia"
      },
      "output": {
        "kind": "file",
        "path": "./graphs/torreya/bulbapedia.trig",
        "mode": "dataset",
        "canonicalize": true
      }
    }
  }
}
