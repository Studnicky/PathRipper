    "entrypoint": "scrape-urls",
    "nodes": [
      {
        "@id": "urn:noocodex:dag:htmlScrapePhase/node/scrape-urls",
        "@type": "ScatterNode",
        "name": "scrape-urls",
        "source": "urls",
        "body": {
          "dag": "htmlPageDAG:aonprd"
        },
        "gather": {
          "strategy": "partition",
          "partitions": {
            "success": "succeeded",
            "error": "failed"
