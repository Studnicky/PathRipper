    "@id": "urn:noocodex:dag:htmlPageDAG:aonprd",
    "@type": "DAG",
    "name": "htmlPageDAG:aonprd",
    "version": "2.0",
    "entrypoint": "html:fetch",
    "nodes": [
      {
        "@id": "urn:noocodex:dag:htmlPageDAG:aonprd/node/html:fetch",
        "@type": "SingleNode",
        "name": "html:fetch",
        "node": "html:fetch",
        "outputs": {
          "success": "aonprd:parse",
          "cached": "aonprd:parse",
          "error": "htmlPage:failed"
        }
      },
      {
        "@id": "urn:noocodex:dag:htmlPageDAG:aonprd/node/aonprd:parse",
        "@type": "EmbeddedDAGNode",
        "name": "aonprd:parse",
        "dag": "aonprd:parse",
        "outputs": {
          "success": "json:write",
          "error": "htmlPage:failed"
        },
        "stateMapping": {
          "input": {
            "page": "page"
          },
          "output": {
            "output": "output"
          }
        }
      },
      {
        "@id": "urn:noocodex:dag:htmlPageDAG:aonprd/node/json:write",
        "@type": "SingleNode",
        "name": "json:write",
        "node": "json:write",
        "outputs": {
          "success": "htmlPage:completed",
          "skipped": "htmlPage:completed"
        }
      },
      {
        "@id": "urn:noocodex:dag:htmlPageDAG:aonprd/node/htmlPage:completed",
        "@type": "TerminalNode",
        "name": "htmlPage:completed",
        "outcome": "completed"
      },
      {
        "@id": "urn:noocodex:dag:htmlPageDAG:aonprd/node/htmlPage:failed",
        "@type": "TerminalNode",
        "name": "htmlPage:failed",
        "outcome": "failed"
      }
    ]
  },
