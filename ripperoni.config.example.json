{
  "output": {
    "basePath": "./output",
    "format": "json",
    "pretty": true
  },
  "mediawiki": {
    "your-wiki-target": {
      "apiUrl":           "https://wiki.example/w/api.php",
      "rateLimitMs":      2000,
      "jitterMs":         500,
      "batchSize":        50,
      "allPagesLimit":    500,
      "maxRetries":       3,
      "retryBaseDelayMs": 500,
      "retryMaxDelayMs":  30000,
      "categories":       ["Example Category A", "Example Category B"],
      "pipeline": ["./plugins/your-target/parse.task.js"]
    }
  },
  "targets": {
    "your-html-target": {
      "baseUrl":          "https://example.com",
      "rateLimitMs":      500,
      "maxRetries":       3,
      "retryBaseDelayMs": 500,
      "retryMaxDelayMs":  30000,
      "headers": {
        "User-Agent": "MyApp/1.0"
      },
      "pipeline": ["./plugins/your-target/parse.task.js"]
    }
  },
  "crawlers": {
    "your-crawler-target": {
      "startUrls":   ["https://example.com/index"],
      "domain":      "example\\.com",
      "target":      "\\?id=",
      "delimiter":   "category",
      "rateLimitMs": 100,
      "jitterMs":    25,
      "maxPages":    1000
    }
  }
}
