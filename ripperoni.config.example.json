{
  "output": {
    "basePath": "./output",
    "format": "json",
    "pretty": true
  },
  "mediawiki": {
    "your-wiki-target": {
      "apiUrl":      "https://wiki.example/w/api.php",
      "rateLimitMs": 2000,
      "jitterMs":    500,
      "categories":  ["Example Category A", "Example Category B"],
      "tasks":       ["./plugins/your-target/parse.task.js"]
    }
  },
  "targets": {
    "your-html-target": {
      "baseUrl":     "https://example.com",
      "rateLimitMs": 500,
      "headers": {
        "User-Agent": "MyApp/1.0"
      },
      "tasks": ["./plugins/your-target/parse.task.js"]
    }
  },
  "crawlers": {
    "your-crawler-target": {
      "startUrls":   ["https://example.com/index"],
      "domain":      "example\\.com",
      "target":      "\\?id=",
      "delimiter":   "category",
      "rateLimitMs": 100,
      "jitterMs":    25,
      "maxPages":    1000
    }
  }
}
