            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Void",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=795",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Deceiver's Cloak"
          },
          "aonprd:description": "Your patron drapes a cloak of illusion about you, making you appear as another creature of the same body shape with roughly similar height and weight as yourself. This has the effects of 3rd-rank illusory disguise.",
          "aonprd:name": "Deceiver's Cloak",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Concentrate",
            "aonprd:Trait-Focus",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Illusion",
            "aonprd:Trait-Manipulate",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=796",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Discern Secrets"
          },
          "aonprd:description": "Your patron deigns to whisper a few secrets. The target can Recall Knowledge, Seek, or Sense Motive as a free action. The target gains a +1 status bonus to the statistic used for the roll (a skill or Perception) on the roll and as long as you Sustain the spell. The target is temporarily immune to discern secrets for 1 minute.",
          "aonprd:name": "Discern Secrets",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Cantrip",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Manipulate",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=797",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Elemental Betrayal"
          },
          "aonprd:description": "Your patron uses its superior command of the elements, empowering them to undermine your foe. When you Cast this Spell, choose air, earth, metal, fire, water, or wood. The target gains weakness 2 to that trait.",
          "aonprd:name": "Elemental Betrayal",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Concentrate",
            "aonprd:Trait-Focus",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=798",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Evil Eye"
          },
          "aonprd:description": "Your patron's resentment manifests in a baleful, envious gaze. The target becomes sickened 1 if it fails a Will save (or sickened 2 on a critical failure). This condition value can't be reduced below 1 while the spell is active and you can see the target.",
          "aonprd:name": "Evil Eye",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Cantrip",
            "aonprd:Trait-Curse",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Manipulate",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=799",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Life Boost"
          },
          "aonprd:description": "Life force from your patron floods into the target, ensuring they can continue doing your patron's will for just a little longer. The target gains fast healing 2.",
          "aonprd:name": "Life Boost",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Focus",
            "aonprd:Trait-Healing",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Manipulate",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Vitality",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=800",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Malicious Shadow"
          },
          "aonprd:description": "Your patron warps the target's shadow into a deadly form, such as strangling hands, a dangerous weapon, harrying runes, or the like. The shadow moves along with the target, always remaining within reach. When you Cast the Spell, and each time you Sustain it, the shadow Strikes the target. The shadow's Strikes are melee spell attacks that deal 2d10 damage. You choose the type of damage (bludgeoning, piercing, or slashing) when you Cast the Spell. The shadow uses and contributes to your multiple attack penalty. The shadow doesn't take up space, grant flanking, or have any other attributes a creature would. The shadow can't make any attacks other than its Strike. The shadow vanishes if the target ceases to cast a shadow (usually if it moves into complete darkness or light). If another effect is controlling the target's shadow when you cast malicious shadow, you can attempt to counteract that effect to temporarily take control of the shadow for malicious shadow's duration.",
          "aonprd:name": "Malicious Shadow",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Concentrate",
            "aonprd:Trait-Focus",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Manipulate",
            "aonprd:Trait-Shadow",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=801",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Needle of Vengeance"
          },
          "aonprd:description": "A long, jagged needle jabs into the target foe's psyche whenever it tries to attack a creature your patron holds in special regard. Name yourself or one of your allies. The target takes 2 mental damage any time it uses a hostile action against the named creature, with a basic Will save.",
          "aonprd:name": "Needle of Vengeance",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Focus",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Manipulate",
            "aonprd:Trait-Mental",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=802",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Nudge Fate"
          },
          "aonprd:description": "The barest spin of your patron's spool is enough to alter fate. When the target fails an attack roll, skill check, or saving throw and a +1 status bonus would turn a critical failure into a failure, or failure into a success, you grant the target a +1 status bonus to the check retroactively, changing the outcome appropriately. The spell then ends. If you cast nudge fate while a previous casting of this hex is still in effect, the previous effect ends.",
          "aonprd:name": "Nudge Fate",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Cantrip",
            "aonprd:Trait-Concentrate",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=803",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Personal Blizzard"
          },
          "aonprd:description": "Your patron's breath becomes a blizzard of obscuring, scouring ice that follows your target. The target attempts a Fortitude save.",
          "aonprd:name": "Personal Blizzard",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Cold",
            "aonprd:Trait-Focus",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=805",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Restorative Moment"
          },
          "aonprd:description": "Your patron weaves the threads of time around the target, giving them some of the benefits of a day's passage. The target decreases the values of any doomed and drained conditions it has by 1 and can immediately attempt one saving throw against each affliction it has with a stage length of 1 day or less. The target is then temporarily immune for 1 day.",
          "aonprd:name": "Restorative Moment",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Concentrate",
            "aonprd:Trait-Focus",
            "aonprd:Trait-Hex",
            "aonprd:Trait-Manipulate",
            "aonprd:Trait-Uncommon",
            "aonprd:Trait-Witch"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=806",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Shroud of Night"
          },
          "aonprd:description": "Your patron blankets the target's eyes in darkness. If you cast this hex on a willing ally (for instance, one with light blindness), the ally can choose which result it gets without rolling.",
          "aonprd:name": "Shroud of Night",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Cantrip",
