          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=1878",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Elemental Betrayal"
          },
          "aonprd:description": "Your patron uses its superior command of the elements, empowering them to undermine your foe. When you Cast this Spell, choose air, earth, metal, fire, water, or wood. The target gains weakness 2 to that trait.",
          "aonprd:name": "Elemental Betrayal",
          "aonprd:rarity": "aonprd:Rarity-uncommon",
          "aonprd:trait": [
            "aonprd:Trait-Concentrate",
            "aonprd:Trait-Focus",
