            "aonprd:Trait-Concentrate",
            "aonprd:Trait-Incapacitation",
            "aonprd:Trait-Manipulate"
          ]
        },
        {
          "@id": "https://squashage.dev/instance/aonprd/Spells.aspx?ID=1454",
          "@type": "aonprd:Spell",
          "rdfs:label": {
            "@language": "en",
            "@value": "Blood Vendetta"
          },
          "aonprd:description": "You curse the target, punishing it for having the audacity to spill your blood. The target takes 2d6 persistent bleed damage and must attempt a Will save.",
          "aonprd:name": "Blood Vendetta",
          "aonprd:rarity": "aonprd:Rarity-common",
