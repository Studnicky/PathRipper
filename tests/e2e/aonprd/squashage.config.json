{
  "input": { "basePath": "./input", "format": "json" },
  "targets": {
    "aonprd": {
      "input": "./input",
      "concurrency": 2,
      "pipeline": [
        "json:read",
        "classify:source",
        "classify:structural",
        "classify:rules",
        "classify:schema",
        "classify:ontology",
        "classify:conflict",
        "aonprd:squash",
        "rdfjs:finalize"
      ],
      "classification": {
        "source": true,
        "structural": [
          {
            "className": "feat",
            "priority": 10,
            "predicate": { "path": "/_type", "equals": "feat" },
            "reasons": ["_type=feat (structural)"]
          },
          {
            "className": "feat",
            "priority": 10,
            "predicate": { "path": "/_type", "equals": "featspell" },
            "reasons": ["_type=featspell matches feat (structural)"]
          },
          {
            "className": "spell",
            "priority": 10,
            "predicate": { "path": "/_type", "equals": "spell" },
            "reasons": ["_type=spell (structural)"]
          },
          {
            "className": "spell",
            "priority": 10,
            "predicate": { "path": "/traditions", "type": "array" },
            "reasons": ["traditions array present (structural)"]
          },
          {
            "className": "monster",
            "priority": 10,
            "predicate": { "path": "/_type", "equals": "monster" },
            "reasons": ["_type=monster (structural)"]
          },
          {
            "className": "action",
            "priority": 10,
            "predicate": { "path": "/_type", "equals": "action" },
            "reasons": ["_type=action (structural)"]
          },
          {
            "className": "equipment",
            "priority": 10,
            "predicate": { "path": "/_type", "equals": "equipment" },
            "reasons": ["_type=equipment (structural)"]
          }
        ],
        "rules": [
          {
            "className": "feat",
            "priority": 20,
            "predicate": {
              "all": [
                { "path": "/_type", "equals": "feat" },
                { "path": "/level", "type": "number" }
              ]
            },
            "reasons": ["_type=feat", "level present"]
          },
          {
            "className": "spell",
            "priority": 20,
            "predicate": {
              "all": [
                { "path": "/_type", "equals": "spell" },
                { "path": "/level", "type": "number" }
              ]
            },
            "reasons": ["_type=spell", "level present"]
          }
        ],
        "schemas": [
          { "className": "feat",      "priority": 30, "schemaPath": "./schemas/feat.schema.json" },
          { "className": "spell",     "priority": 30, "schemaPath": "./schemas/spell.schema.json" },
          { "className": "monster",   "priority": 30, "schemaPath": "./schemas/monster.schema.json" },
          { "className": "action",    "priority": 30, "schemaPath": "./schemas/action.schema.json" },
          { "className": "equipment", "priority": 30, "schemaPath": "./schemas/equipment.schema.json" }
        ],
        "ontology": {
          "classes": {
            "feat":      "https://squashage.dev/vocabulary/aonprd#Feat",
            "spell":     "https://squashage.dev/vocabulary/aonprd#Spell",
            "monster":   "https://squashage.dev/vocabulary/aonprd#Monster",
            "action":    "https://squashage.dev/vocabulary/aonprd#Action",
            "equipment": "https://squashage.dev/vocabulary/aonprd#Equipment"
          }
        },
        "conflict": {
          "onConflict": "quarantine",
          "onUnknown":  "quarantine",
          "evidence":   true
        }
      },
      "output": {
        "kind":         "file",
        "path":         "./out/aonprd.jsonld",
        "mode":         "dataset",
        "canonicalize": true
      }
    }
  }
}
