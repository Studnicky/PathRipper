{
  "name": "ripperoni",
  "version": "2.0.0",
  "description": "Configurable web scraper — pluggable pipeline tasks, HTML and MediaWiki modes, recursive link crawler.",
  "type": "module",
  "bin": {
    "ripperoni": "./dist/cli/cli.js"
  },
  "exports": {
    "./errors":            "./dist/errors/index.js",
    "./schemas":           "./dist/schemas/index.js",
    "./Pipeline":          "./dist/pipeline/Pipeline.js",
    "./LinkLister":        "./dist/crawlers/LinkLister.js",
    "./HtmlScraper":       "./dist/scrapers/HtmlScraper.js",
    "./MediaWikiScraper":  "./dist/scrapers/MediaWikiScraper.js",
    "./WikitextParser":    "./dist/scrapers/WikitextParser.js",
    "./reporter":          "./dist/tasks/reporter.js",
    "./exportJson":        "./dist/tasks/exportJson.js",
    "./ErrorClassifier":   "./dist/modules/http/ErrorClassifier.js",
    "./RetryExecutor":     "./dist/modules/http/RetryExecutor.js",
    "./RateLimiter":       "./dist/modules/http/RateLimiter.js",
    "./Logger":            "./dist/modules/logger/Logger.js",
    "./Time":              "./dist/modules/time/Time.js",
    "./RipperConfig":      "./dist/config/RipperConfig.js",
    "./MappingEngine":     "./dist/mapping/MappingEngine.js",
    "./FilterRegistry":    "./dist/mapping/FilterRegistry.js",
    "./TemplateParser":    "./dist/mapping/TemplateParser.js",
    "./ExternalSchemaLoader": "./dist/loaders/ExternalSchemaLoader.js"
  },
  "scripts": {
    "build": "tsc --noEmit false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "test": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "dev": "node --watch dist/cli/cli.js",
    "prepare": "bash scripts/install-hooks.sh",
    "test:integration": "node --test tests/integration/**/*.test.ts",
    "test:e2e": "node --import tsx --test 'tests/e2e/**/*.test.ts'"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "json-schema-to-ts": "^3.1.1",
    "mwn": "^3.0.2",
    "wtf_wikipedia": "^10.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.18.0",
    "globals": "^15.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.59.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "a.j.studnicky@gmail.com",
  "license": "UNLICENSED"
}
