{
  "name": "squashage",
  "version": "0.1.0",
  "description": "Graph reconstitution pipeline — pluggable classifiers and normalizers that squash Ripperoni JSON into RDF/JS.",
  "type": "module",
  "bin": {
    "squashage": "./dist/cli/cli.js"
  },
  "exports": {
    "./config/ConfigClamp": "./dist/config/ConfigClamp.js",
    "./Pipeline": "./dist/pipeline/Pipeline.js",
    "./ConcurrentPipeline": "./dist/pipeline/ConcurrentPipeline.js",
    "./Logger": "./dist/modules/logger/logger.js",
    "./RipperConfig": "./dist/config/RipperConfig.js",
    "./errors/BaseError": "./dist/errors/BaseError.js",
    "./errors/HttpError": "./dist/errors/HttpError.js",
    "./errors/RipperConfigError": "./dist/errors/RipperConfigError.js",
    "./errors/ExternalSchemaError": "./dist/errors/ExternalSchemaError.js",
    "./registry/TaskRegistry": "./dist/registry/TaskRegistry.js",
    "./registry/PipelineState": "./dist/registry/PipelineState.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc --noEmit false && npm run build:plugins",
    "build:plugins": "tsc -p tsconfig.plugins.json --noEmit false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "test": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "dev": "node --watch dist/cli/cli.js",
    "postinstall": "bash scripts/install-hooks.sh",
    "prepare": "bash scripts/install-hooks.sh",
    "test:integration": "node --test tests/integration/**/*.test.ts",
    "test:e2e": "node --import tsx --test 'tests/e2e/**/*.test.ts'"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.0.0",
    "json-schema-to-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.18.0",
    "globals": "^15.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.59.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "sideEffects": false,
  "author": "a.j.studnicky@gmail.com",
  "license": "UNLICENSED"
}
