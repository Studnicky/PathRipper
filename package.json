{
  "name": "@studnicky/ripperoni",
  "version": "3.1.1",
  "description": "Web ingestion engine; slices wikis, sites, and URL lists into JSON records, one page at a time. Pairs with Squashage for RDF graph reconstitution.",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/Ripperoni.git"
  },
  "files": [
    "dist/",
    "dist-workers/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "ripperoni": "./dist/cli/cli.js"
  },
  "exports": {
    "./HtmlScraper": "./dist/scrapers/HtmlScraper.js",
    "./MediaWikiScraper": "./dist/scrapers/MediaWikiScraper.js",
    "./WikitextParser": "./dist/scrapers/WikitextParser.js",
    "./ErrorClassifier": "./dist/modules/http/errorClassifier.js",
    "./RateLimiter": "./dist/modules/http/rateLimiter.js",
    "./Logger": "./dist/modules/logger/logger.js",
    "./Time": "./dist/modules/http/time.js",
    "./errors/BaseError": "./dist/errors/BaseError.js",
    "./errors/HttpError": "./dist/errors/HttpError.js",
    "./errors/RipperConfigError": "./dist/errors/RipperConfigError.js",
    "./errors/ExternalSchemaError": "./dist/errors/ExternalSchemaError.js",
    "./state/ScrapeState": "./dist/state/ScrapeState.js",
    "./nodes": "./dist/nodes/index.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "prepack": "npm run build",
    "build": "tsc --noEmit false && npm run build:plugins && npm run build:workers && npm run build:assets",
    "build:assets": "node scripts/copy-dag-assets.mjs",
    "build:plugins": "tsc -p tsconfig.plugins.json --noEmit false",
    "build:workers": "tsc -p tsconfig.workers.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "test": "node --experimental-test-module-mocks --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:unit": "node --experimental-test-module-mocks --import tsx --test 'tests/unit/**/*.test.ts'",
    "check": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run test:unit",
    "dev": "node --watch dist/cli/cli.js",
    "postinstall": "bash scripts/install-hooks.sh",
    "prepare": "bash scripts/install-hooks.sh",
    "test:integration": "node --experimental-test-module-mocks --import tsx --test 'tests/integration/**/*.test.ts'",
    "test:e2e": "node --import tsx --test 'tests/e2e/**/*.test.ts'",
    "docs:dev": "vitepress dev docs",
    "docs:render-og": "node scripts/render-og.mjs",
    "docs:build": "node --import tsx docs/.vitepress/scripts/render-dags.mjs && node scripts/render-og.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@studnicky/dagonizer": "^0.24.0",
    "@studnicky/dagonizer-executor-node": "^0.24.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.0.0",
    "commander": "^14.0.3",
    "domhandler": "^6.0.1",
    "json-schema-to-ts": "^3.1.1",
    "wtf_wikipedia": "^10.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "cytoscape": "^3.34.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "mermaid": "^11.15.0",
    "sharp": "^0.35.2",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "author": "a.j.studnicky@gmail.com",
  "license": "UNLICENSED",
  "ripperoni": {
    "seo": {
      "googleSiteVerification": "",
      "bingSiteVerification": "",
      "twitterHandle": ""
    }
  }
}
