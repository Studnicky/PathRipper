{
  "name": "ripperoni",
  "version": "2.6.0",
  "description": "Web ingestion engine; slices wikis, sites, and URL lists into JSON records, one page at a time. Pairs with Squashage for RDF graph reconstitution.",
  "type": "module",
  "bin": {
    "ripperoni": "./dist/cli/cli.js"
  },
  "exports": {
    "./config/ConfigClamp": "./dist/config/ConfigClamp.js",
    "./Pipeline": "./dist/pipeline/Pipeline.js",
    "./ConcurrentPipeline": "./dist/pipeline/ConcurrentPipeline.js",
    "./LinkLister": "./dist/crawlers/LinkLister.js",
    "./HtmlScraper": "./dist/scrapers/HtmlScraper.js",
    "./MediaWikiScraper": "./dist/scrapers/MediaWikiScraper.js",
    "./WikitextParser": "./dist/scrapers/WikitextParser.js",
    "./ErrorClassifier": "./dist/modules/http/errorClassifier.js",
    "./RetryExecutor": "./dist/modules/http/retryExecutor.js",
    "./RateLimiter": "./dist/modules/http/rateLimiter.js",
    "./Logger": "./dist/modules/logger/logger.js",
    "./Time": "./dist/modules/http/time.js",
    "./RipperConfig": "./dist/config/RipperConfig.js",
    "./errors/BaseError": "./dist/errors/BaseError.js",
    "./errors/HttpError": "./dist/errors/HttpError.js",
    "./errors/RipperConfigError": "./dist/errors/RipperConfigError.js",
    "./errors/ExternalSchemaError": "./dist/errors/ExternalSchemaError.js",
    "./registry/TaskRegistry": "./dist/registry/TaskRegistry.js",
    "./registry/PipelineState": "./dist/registry/PipelineState.js",
    "./orchestrators/ScrapeOrchestrator": "./dist/orchestrators/ScrapeOrchestrator.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc --noEmit false && npm run build:plugins",
    "build:plugins": "tsc -p tsconfig.plugins.json --noEmit false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "test": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "dev": "node --watch dist/cli/cli.js",
    "postinstall": "bash scripts/install-hooks.sh",
    "prepare": "bash scripts/install-hooks.sh",
    "test:integration": "node --import tsx --test 'tests/integration/**/*.test.ts'",
    "test:e2e": "node --import tsx --test 'tests/e2e/**/*.test.ts'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.0.0",
    "commander": "^14.0.3",
    "domhandler": "^6.0.1",
    "json-schema-to-ts": "^3.1.1",
    "wtf_wikipedia": "^10.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "mermaid": "^11.15.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "sideEffects": false,
  "author": "a.j.studnicky@gmail.com",
  "license": "UNLICENSED",
  "ripperoni": {
    "seo": {
      "googleSiteVerification": "",
      "bingSiteVerification": "",
      "twitterHandle": ""
    }
  }
}
