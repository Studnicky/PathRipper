  "@id": "urn:noocodex:dag:aonprd:page",
  "@type": "DAG",
  "name": "aonprd:page",
  "version": "1.0",
  "entrypoint": "html:fetch",
  "nodes": [
    {
      "@id": "urn:noocodex:dag:aonprd:page/node/html:fetch",
      "@type": "SingleNode",
      "name": "html:fetch",
      "node": "html:fetch",
      "outputs": {
        "success": "aonprd:parse",
        "cached": "aonprd:parse",
        "error": "aonprd-page:failed"
      }
    },
    {
      "@id": "urn:noocodex:dag:aonprd:page/node/aonprd:parse",
      "@type": "EmbeddedDAGNode",
      "name": "aonprd:parse",
      "dag": "aonprd:parse",
      "outputs": {
        "success": "json:write",
        "error": "aonprd-page:failed"
      },
      "stateMapping": {
        "input": {
          "page": "page"
        },
        "output": {
          "output": "output"
        }
      }
    },
    {
      "@id": "urn:noocodex:dag:aonprd:page/node/json:write",
      "@type": "SingleNode",
      "name": "json:write",
      "node": "json:write",
      "outputs": {
        "success": "aonprd-page:completed",
        "skipped": "aonprd-page:completed"
      }
    },
    {
      "@id": "urn:noocodex:dag:aonprd:page/node/aonprd-page:completed",
      "@type": "TerminalNode",
      "name": "aonprd-page:completed",
      "outcome": "completed"
    },
    {
      "@id": "urn:noocodex:dag:aonprd:page/node/aonprd-page:failed",
      "@type": "TerminalNode",
      "name": "aonprd-page:failed",
      "outcome": "failed"
    }
  ]
}