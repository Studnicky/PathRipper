  "required": [
    "_type",
    "alt_edition_url",
    "body_text",
    "entity_id",
    "legacy",
    "links",
    "mechanics",
    "name",
    "pfs",
    "popular_anathema",
    "popular_edicts",
    "rarity",
    "sections",
    "source",
    "sources",
    "traits",
    "url"
