{
  "$id": "https://2e.aonprd.com/Shield",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "$ref": "https://noocodec.dev/squashage/core/ContentEntry.schema.json"
    }
  ],
  "properties": {
    "_type": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/ShieldType.draft.json"
    },
    "ac_bonus": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/ShieldAcBonus.draft.json"
    },
    "alt_edition_url": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/ShieldAltEditionUrl.draft.json"
    },
    "armor_id": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/ShieldArmorId.draft.json"
    },
    "bulk": {
      "maximum": 1,
      "minimum": 1,
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "category": {
      "type": "null"
    },
    "check_penalty": {
      "type": "null"
    },
    "description_text": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/ShieldDescriptionText.draft.json",
      "x-squashage-open-vocab": true
    },
    "dex_cap": {
      "type": "null"
    },
    "group": {
      "type": "null"
    },
    "legacy": {
      "type": "boolean"
    },
    "links": {
      "items": {
        "$ref": "https://2e.aonprd.com/schemas/inferred/objects/ShieldLink.draft.json"
      },
      "type": "array"
    },
    "name": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/ShieldName.draft.json",
      "x-squashage-open-vocab": true
    },
    "pfs": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/ArmorPfs.draft.json",
      "x-squashage-closed-enum": true
    },
    "price": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/objects/ShieldPrice.draft.json"
    },
    "rarity": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/MonsterFamilyRarity.draft.json",
      "x-squashage-closed-enum": true,
      "x-squashage-range": "Rarity"
    },
    "source": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/objects/ShieldSource.draft.json"
    },
    "sources": {
      "items": {
        "$ref": "https://2e.aonprd.com/schemas/inferred/objects/ShieldSource_2.draft.json"
      },
      "type": "array"
    },
    "speed_penalty": {
      "type": "null"
    },
    "strength": {
      "type": "null"
    },
    "traits": {
      "items": {
        "type": "null"
      },
      "type": "array"
    },
    "url": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/IriString_4.draft.json",
      "format": "iri",
      "x-squashage-iri-promotion": true
    }
  },
  "required": [
    "_type",
    "ac_bonus",
    "alt_edition_url",
    "armor_id",
    "bulk",
    "category",
    "check_penalty",
    "description_text",
    "dex_cap",
    "group",
    "legacy",
    "links",
    "name",
    "pfs",
    "price",
    "rarity",
    "source",
    "sources",
    "speed_penalty",
    "strength",
    "traits",
    "url"
  ],
  "title": "Shield",
  "type": "object",
  "x-squashage-array-enum-iri": {
    "traits": "Trait"
  },
  "x-squashage-class": "https://2e.aonprd.com/Shield",
  "x-squashage-provenance": {
    "from": "/url",
    "predicate": "dct:source"
  },
  "x-squashage-rdfs-comment": "/description_text",
  "x-squashage-rdfs-label": "/name",
  "x-squashage-subject-iri": {
    "fallback": "/name",
    "from": "/url",
    "sanitize": "url-tail"
  }
}
