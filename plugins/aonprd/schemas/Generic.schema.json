{
  "$id": "https://2e.aonprd.com/Generic",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "$ref": "https://noocodec.dev/squashage/core/ContentEntry.schema.json"
    }
  ],
  "properties": {
    "_type": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/GenericType.draft.json"
    },
    "alt_edition_url": {
      "type": [
        "string",
        "null"
      ],
      "x-squashage-open-vocab": true
    },
    "body_text": {
      "type": "string",
      "x-squashage-open-vocab": true
    },
    "entity_id": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/GenericEntityId.draft.json"
    },
    "legacy": {
      "type": "boolean"
    },
    "level": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/GenericLevel.draft.json"
    },
    "level_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "items": {
        "$ref": "https://2e.aonprd.com/schemas/inferred/objects/GenericLink.draft.json"
      },
      "type": "array"
    },
    "name": {
      "type": "string",
      "x-squashage-open-vocab": true
    },
    "pfs": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/EquipmentPfs.draft.json",
      "x-squashage-open-vocab": true
    },
    "rarity": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/EquipmentRarity.draft.json"
    },
    "sections": {
      "items": {
        "$ref": "https://2e.aonprd.com/schemas/inferred/objects/GenericSection.draft.json"
      },
      "type": "array"
    },
    "source": {
      "properties": {
        "book": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "maximum": 576,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source_id": {
          "maximum": 319,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "https://2e.aonprd.com/schemas/inferred/objects/GenericSource.draft.json"
      },
      "type": "array"
    },
    "traits": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "url": {
      "$ref": "https://2e.aonprd.com/schemas/inferred/primitives/IriString.draft.json",
      "format": "iri",
      "x-squashage-iri-promotion": true
    }
  },
  "required": [
    "_type",
    "alt_edition_url",
    "body_text",
    "entity_id",
    "legacy",
    "level",
    "level_kind",
    "links",
    "name",
    "pfs",
    "rarity",
    "sections",
    "source",
    "sources",
    "traits",
    "url"
  ],
  "title": "Generic",
  "type": "object",
  "x-squashage-array-enum-iri": {
    "traits": "Trait"
  },
  "x-squashage-class": "https://2e.aonprd.com/Generic",
  "x-squashage-provenance": {
    "from": "/url",
    "predicate": "dct:source"
  },
  "x-squashage-rdfs-comment": "/body_text",
  "x-squashage-rdfs-label": "/name",
  "x-squashage-subject-iri": {
    "fallback": "/name",
    "from": "/url",
    "sanitize": "url-tail"
  }
}
