    "nodes": [
      {
        "@id": "urn:noocodex:dag:htmlRetryPhase/node/retry-urls",
        "@type": "ScatterNode",
        "name": "retry-urls",
        "source": "failed",
        "body": {
          "dag": "htmlPageDAG:ripperoni-docs"
        },
        "gather": {
