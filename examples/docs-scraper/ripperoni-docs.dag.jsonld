        "@id": "urn:noocodex:dag:htmlScrapeDAG/node/scrape",
        "@type": "EmbeddedDAGNode",
        "name": "scrape",
        "dag": "htmlScrapePhase",
        "outputs": {
          "success": "retry",
          "error": "retry"
        },
        "stateMapping": {
          "input": {
            "urls": "urls"
          },
          "output": {
            "succeeded": "succeeded",
            "failed": "failed"
          }
        }
