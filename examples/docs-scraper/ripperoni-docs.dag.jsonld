    "@id": "urn:noocodex:dag:htmlPageDAG:ripperoni-docs",
    "@type": "DAG",
    "name": "htmlPageDAG:ripperoni-docs",
    "version": "2.0",
    "entrypoint": "docs:parse",
    "nodes": [
      {
        "@id": "urn:noocodex:dag:htmlPageDAG:ripperoni-docs/node/docs:parse",
        "@type": "EmbeddedDAGNode",
        "name": "docs:parse",
        "dag": "docs:parse",
        "outputs": {
          "success": "htmlPage:completed",
          "error": "htmlPage:failed"
        },
        "stateMapping": {
          "input": {
            "page": "page"
          },
          "output": {
            "output": "output"
          }
        }
      },
      {
        "@id": "urn:noocodex:dag:htmlPageDAG:ripperoni-docs/node/htmlPage:completed",
        "@type": "TerminalNode",
        "name": "htmlPage:completed",
        "outcome": "completed"
      },
