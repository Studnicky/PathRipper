    "@id": "urn:noocodex:dag:htmlScrapePhase",
    "@type": "DAG",
    "name": "htmlScrapePhase",
    "version": "2.0",
    "entrypoint": "scrape-urls",
    "nodes": [
      {
        "@id": "urn:noocodex:dag:htmlScrapePhase/node/scrape-urls",
        "@type": "ScatterNode",
        "name": "scrape-urls",
        "source": "urls",
        "body": {
          "dag": "htmlPageDAG:ripperoni-docs"
        },
        "gather": {
          "strategy": "partition",
          "partitions": {
            "success": "succeeded",
            "error": "failed"
          }
        },
        "outputs": {
          "all-success": "phase-done",
          "partial": "phase-done",
          "all-error": "phase-done",
          "empty": "phase-done"
        },
        "itemKey": "currentUrl",
        "reducer": "aggregate",
        "concurrency": 4
      },
      {
        "@id": "urn:noocodex:dag:htmlScrapePhase/node/phase-done",
        "@type": "TerminalNode",
        "name": "phase-done",
        "outcome": "completed"
      }
    ]
  },
