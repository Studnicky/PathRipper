        "@type": "EmbeddedDAGNode",
        "name": "scrape",
        "dag": "wikiScrapePhase",
        "outputs": {
          "success": "retry",
          "error": "retry"
        },
        "stateMapping": {
          "input": {
            "titles": "titles"
          },
          "output": {
            "succeeded": "succeeded",
            "failed": "failed"
