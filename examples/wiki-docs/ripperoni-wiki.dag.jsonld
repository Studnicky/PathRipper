    "entrypoint": "wiki-docs:parse",
    "nodes": [
      {
        "@id": "urn:noocodex:dag:wikiPageDAG:ripperoni-wiki/node/wiki-docs:parse",
        "@type": "EmbeddedDAGNode",
        "name": "wiki-docs:parse",
        "dag": "wiki-docs:parse",
        "outputs": {
          "success": "wikiPage:completed",
          "error": "wikiPage:failed"
        },
        "stateMapping": {
          "input": {
            "page": "page"
          },
          "output": {
            "output": "output"
          }
        }
      },
      {
        "@id": "urn:noocodex:dag:wikiPageDAG:ripperoni-wiki/node/wikiPage:completed",
