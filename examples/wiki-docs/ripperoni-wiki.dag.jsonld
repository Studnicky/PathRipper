    "@id": "urn:noocodex:dag:wikiScrapePhase",
    "@type": "DAG",
    "name": "wikiScrapePhase",
    "version": "2.0",
    "entrypoint": "scrape-titles",
    "nodes": [
      {
        "@id": "urn:noocodex:dag:wikiScrapePhase/node/scrape-titles",
        "@type": "ScatterNode",
        "name": "scrape-titles",
        "source": "titles",
        "body": {
          "dag": "wikiPageDAG:ripperoni-wiki"
        },
        "gather": {
          "strategy": "partition",
          "partitions": {
            "success": "succeeded",
            "error": "failed"
          }
        },
        "outputs": {
          "all-success": "phase-done",
          "partial": "phase-done",
          "all-error": "phase-done",
          "empty": "phase-done"
        },
        "itemKey": "currentTitle",
        "reducer": "aggregate",
        "concurrency": 8
      },
      {
        "@id": "urn:noocodex:dag:wikiScrapePhase/node/phase-done",
        "@type": "TerminalNode",
        "name": "phase-done",
        "outcome": "completed"
      }
    ]
  },
