    },
    "ScatterNode": {
      "@id": "https://noocodex.dev/ontology/dag/ScatterNode"
    },
    "EmbeddedDAGNode": {
      "@id": "https://noocodex.dev/ontology/dag/EmbeddedDAGNode"
    },
    "TerminalNode": {
      "@id": "https://noocodex.dev/ontology/dag/TerminalNode"
    },
    "PhaseNode": {
      "@id": "https://noocodex.dev/ontology/dag/PhaseNode"
    }
  },
  "@id": "urn:noocodex:dag:wiki:scrape",
  "@type": "DAG",
  "name": "wiki:scrape",
  "version": "1.0",
  "entrypoint": "scatter-titles",
  "nodes": [
    {
      "@id": "urn:noocodex:dag:wiki:scrape/node/scatter-titles",
      "@type": "ScatterNode",
      "name": "scatter-titles",
      "source": "titles",
      "body": {
        "dag": "wiki:page"
      },
      "itemKey": "currentTitle",
      "gather": {
        "strategy": "partition",
        "partitions": {
          "success": "succeeded",
          "error": "failed"
        }
      },
      "reducer": "aggregate",
      "concurrency": 8,
      "outputs": {
        "all-success": "wiki:completed",
        "partial": "wiki:completed",
        "all-error": "wiki:failed",
        "empty": "wiki:completed"
      }
    },
    {
      "@id": "urn:noocodex:dag:wiki:scrape/node/wiki:completed",
      "@type": "TerminalNode",
      "name": "wiki:completed",
      "outcome": "completed"
    },
    {
      "@id": "urn:noocodex:dag:wiki:scrape/node/wiki:failed",
      "@type": "TerminalNode",
      "name": "wiki:failed",
      "outcome": "failed"
    }
  ]
}
